generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Frequency {
  monthly
  quarterly
  yearly
  event_based
}

enum TaskStatus {
  pending
  completed
}

enum AssignedStatus {
  active
  inactive
}

model Company {
  id            String   @id @default(uuid())
  name          String
  industry      String?
  type          String?
  employeeCount Int?
  turnover      Decimal? @db.Decimal(18, 2)
  state         String?
  createdAt     DateTime @default(now())

  users               User[]
  assignedCompliances AssignedCompliance[]
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  companyId String?
  roleId    String

  company   Company? @relation(fields: [companyId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
}

model ComplianceCategory {
  id   String @id @default(uuid())
  name String @unique

  compliances Compliance[]
}

model Compliance {
  id             String    @id @default(uuid())
  title          String
  description    String?
  categoryId     String
  frequency      Frequency
  applicableLaw  String

  category       ComplianceCategory @relation(fields: [categoryId], references: [id])
  rules          ComplianceRule[]
  assignedTo     AssignedCompliance[]
}

model ComplianceRule {
  id           String   @id @default(uuid())
  complianceId String
  condition    Json

  compliance   Compliance @relation(fields: [complianceId], references: [id])

  @@unique([complianceId])
}

model AssignedCompliance {
  id              String          @id @default(uuid())
  companyId       String
  complianceId    String
  status          AssignedStatus  @default(active)
  isManualOverride Boolean        @default(false)
  createdAt       DateTime        @default(now())

  company         Company    @relation(fields: [companyId], references: [id])
  compliance      Compliance @relation(fields: [complianceId], references: [id])
  tasks           Task[]

  @@unique([companyId, complianceId])
}

model Task {
  id                   String      @id @default(uuid())
  assignedComplianceId String
  dueDate              DateTime?
  status               TaskStatus  @default(pending)
  remarks              String?
  createdAt            DateTime    @default(now())

  assignedCompliance   AssignedCompliance @relation(fields: [assignedComplianceId], references: [id])
}
