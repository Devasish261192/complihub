generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  companyType String?
  cin       String?
  pan       String?
  gstNumber String?
  state     String?
  industry  String?
  employeeCount Int?
  incorporationDate DateTime?
  gstRegistered Boolean? @default(false)
  createdAt DateTime @default(now())

  users     User[]
  tasks     Task[]
}

model Role {
  id    String @id @default(uuid())
  name  String @unique

  users User[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  companyId String
  roleId    String

  company   Company  @relation(fields: [companyId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  tasks     TaskAssignment[]
}

model Framework {
  id          String   @id @default(uuid())
  name        String
  description String?

  controls    Control[]
}

model Control {
  id          String   @id @default(uuid())
  name        String
  description String?

  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id])

  requirements Requirement[]
}

model Requirement {
  id          String   @id @default(uuid())
  description String

  controlId   String
  control     Control @relation(fields: [controlId], references: [id])

  tasks       Task[]
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?
  status       String   @default("pending")
  dueDate      DateTime?
  createdAt    DateTime @default(now())

  companyId    String
  requirementId String

  company      Company     @relation(fields: [companyId], references: [id])
  requirement  Requirement @relation(fields: [requirementId], references: [id])

  assignments  TaskAssignment[]
  evidence     Evidence[]
}


model TaskAssignment {
  id     String @id @default(uuid())

  taskId String
  userId String

  task   Task @relation(fields: [taskId], references: [id])
  user   User @relation(fields: [userId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  name      String
  filePath  String
  uploadedAt DateTime @default(now())
}

model Evidence {
  id       String @id @default(uuid())

  taskId   String
  filePath String

  task     Task @relation(fields: [taskId], references: [id])
}

model Risk {
  id          String   @id @default(uuid())
  title       String
  description String?
  severity    String
  createdAt   DateTime @default(now())
}

model Audit {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  findings  AuditFinding[]
}

model AuditFinding {
  id          String   @id @default(uuid())
  description String
  severity    String

  auditId     String
  audit       Audit @relation(fields: [auditId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  createdAt DateTime @default(now())
}
